{
  "name": "rainlane-blades",
  "version": "1.0.0",
  "private": true,
  "description": "雨巷双刃 / Rainlane Blades — an original third-person 3D boss-fight prototype",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "install:browsers": "playwright install chromium",
    "shots": "node tests/compare-shots.mjs",
    "shots:before": "node tests/compare-shots.mjs before",
    "shots:after": "node tests/compare-shots.mjs after",
    "shots:review": "vite build && node tests/compare-shots.mjs after review seq",
    "test:sim": "node --test tests/sim.test.mjs",
    "test:offline": "playwright test"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "pngjs": "^7.0.0",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
